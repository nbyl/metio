#cloud-config
device_aliases: {minecraft-data: /dev/disk/by-id/google-minecraft-data}
fs_setup:
  - {device: minecraft-data, filesystem: ext4, label: fs1}
mounts:
  - [minecraft-data, /mnt/disks/minecraft/data, ext4, "defaults", "0", "2"]
users:
  - name: metio
    gecos: Metio User
    shell: /bin/bash
    primary_group: metio
    groups: docker
    system: false
write_files:
  - path: /home/metio/verify-minecraft-image.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      IMAGE="itzg/minecraft-server:stable-java21"
      MAX_RETRIES=3
      RETRY_DELAY=10

      log() {
          echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
      }

      verify_image() {
          local image=$1
          log "Verifying Docker image: $image"

          # Check if image exists
          if ! docker image inspect "$image" >/dev/null 2>&1; then
              log "Image $image not found locally"
              return 1
          fi

          # Create a temporary container to check the Java executable
          local container_id=$(docker create "$image" echo "test")

          # Check if java executable exists and has proper size
          if docker run --rm "$image" test -f /opt/java/openjdk/bin/java; then
              local java_size=$(docker run --rm "$image" stat -c%s /opt/java/openjdk/bin/java 2>/dev/null || echo "0")
              if [ "$java_size" -gt 1000 ]; then
                  log "Java executable verified (size: $java_size bytes)"
                  docker rm "$container_id" >/dev/null 2>&1 || true
                  return 0
              else
                  log "Java executable too small or corrupted (size: $java_size bytes)"
                  docker rm "$container_id" >/dev/null 2>&1 || true
                  return 1
              fi
          else
              log "Java executable not found in image"
              docker rm "$container_id" >/dev/null 2>&1 || true
              return 1
          fi
      }

      pull_with_retry() {
          local image=$1
          local attempt=1

          while [ $attempt -le $MAX_RETRIES ]; do
              log "Attempt $attempt/$MAX_RETRIES: Pulling $image"

              # Remove any existing corrupted image
              if docker image inspect "$image" >/dev/null 2>&1; then
                  log "Removing existing image before re-pulling"
                  docker rmi -f "$image" >/dev/null 2>&1 || true
              fi

              # Pull the image
              if docker pull "$image"; then
                  log "Image pulled successfully, verifying..."

                  # Verify the image
                  if verify_image "$image"; then
                      log "Image verification successful"
                      return 0
                  else
                      log "Image verification failed"
                  fi
              else
                  log "Failed to pull image"
              fi

              if [ $attempt -lt $MAX_RETRIES ]; then
                  log "Waiting $RETRY_DELAY seconds before retry..."
                  sleep $RETRY_DELAY
              fi

              attempt=$((attempt + 1))
          done

          log "Failed to pull and verify image after $MAX_RETRIES attempts"
          return 1
      }

      # Main execution
      log "Starting Minecraft image verification and pull process"

      if pull_with_retry "$IMAGE"; then
          log "Minecraft image is ready"
          exit 0
      else
          log "CRITICAL: Failed to prepare Minecraft image"
          exit 1
      fi
  - path: /etc/systemd/system/minecraft.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Minecraft Server
      After=docker.service
      Requires=docker.service

      [Service]
      User=metio
      WorkingDirectory=/home/metio
      TimeoutStartSec=0
      Restart=always
      ExecStartPre=-/usr/bin/docker stop %n
      ExecStartPre=-/usr/bin/docker rm %n
      ExecStartPre=/home/metio/verify-minecraft-image.sh
      ExecStart=/usr/bin/docker run --rm --name %n \
        -p 25565:25565 \
        -p 127.0.0.1:25575:25575 \
        -e EULA=TRUE \
        -e VERSION=${minecraft_version} \
        -e MAX_MEMORY=3G \
        -e USE_MEOWICE_FLAGS=true \
        -e RCON_PASSWORD=minecraft2025 \
        -v /mnt/disks/minecraft/data:/data \
        itzg/minecraft-server:stable-java21
      ExecStop=/usr/bin/docker stop %n

      [Install]
      WantedBy=default.target
  - path: /etc/systemd/system/minecraft-backup.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Minecraft Server
      After=minecraft.service
      Requires=minecraft.service

      [Service]
      User=metio
      WorkingDirectory=/home/metio
      TimeoutStartSec=0
      Restart=always
      ExecStartPre=-/usr/bin/docker stop %n
      ExecStartPre=-/usr/bin/docker rm %n
      ExecStartPre=/usr/bin/docker pull itzg/mc-backup
      ExecStart=/usr/bin/docker run --rm --name %n \
        --network host \
        -e BACKUP_METHOD=restic \
        -e BACKUP_INTERVAL=1h \
        -e RESTIC_REPOSITORY=gs:${backup_bucket}:/ \
        -e RESTIC_PASSWORD=minecraft2025 \
        -e RCON_HOST=127.0.0.1 \
        -e RCON_PASSWORD=minecraft2025 \
        -v /mnt/disks/minecraft/data:/data \
        itzg/mc-backup
      ExecStop=/usr/bin/docker stop %n

      [Install]
      WantedBy=default.target
  - path: /etc/systemd/system/metio-machine-agent.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Metio Machine Agent
      After=docker.service
      Requires=docker.service
       [Service]
       User=metio
       WorkingDirectory=/home/metio
       TimeoutStartSec=0
       Restart=always
       ExecStartPre=/usr/bin/docker-credential-gcr configure-docker --registries ${region}-docker.pkg.dev
       ExecStartPre=-/usr/bin/docker stop %n
       ExecStartPre=-/usr/bin/docker rm %n
       ExecStartPre=/usr/bin/docker pull ${machine_agent_image}
       ExecStart=/usr/bin/docker run --rm --name %n \
         -v /var/run/docker.sock:/var/run/docker.sock \
         -e ENVIRONMENT=${environment} \
         -e REGION=${region} \
         -e INSTANCE_NAME=${instance_name} \
         ${machine_agent_image}
      ExecStop=/usr/bin/docker stop %n

      [Install]
      WantedBy=default.target
runcmd:
  - chmod +x /home/metio/verify-minecraft-image.sh
  - chown metio:metio /home/metio/verify-minecraft-image.sh
  - systemctl daemon-reload
  - systemctl enable minecraft minecraft-backup metio-machine-agent
  - systemctl start minecraft minecraft-backup metio-machine-agent
