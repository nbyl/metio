{
	"name": "Metio Dev Container",
	"image": "mcr.microsoft.com/devcontainers/go:2-1.26",
	"runArgs": ["--env-file",".devcontainer/devcontainer.env"],
	"features": {
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/robbert229/devcontainer-features/opentofu:1": {},
		"ghcr.io/gvatsal60/dev-container-features/pre-commit:1": {},
		"ghcr.io/azutake/devcontainer-features/go-packages-install:0": {
			"PACKAGES": "github.com/air-verse/air@v1.62.0"
		}
	},
	"postCreateCommand": "cd frontend && npm install",
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"a-h.templ",
				"opentofu.vscode-opentofu",
				"gitlab.gitlab-workflow"
			]
		}
	}
}
