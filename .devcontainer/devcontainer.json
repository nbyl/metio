{
	"name": "Metio Dev Container",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"runArgs": ["--env-file",".devcontainer/devcontainer.env"],
	"mounts": [
		"source=${env:HOME}/.config/opencode,target=/home/vscode/.config/opencode,type=bind",
		"source=${env:HOME}/.local/share/opencode,target=/home/vscode/.local/share/opencode,type=bind",
		"source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
	],
	"features": {
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/gvatsal60/dev-container-features/pre-commit:1": {}
	},
	"forwardPorts": [50001, 8081],
	"initializeCommand": "mkdir -p \"$HOME/.config/opencode\" \"$HOME/.local/share/opencode\" && cp -n .devcontainer/devcontainer.env.example .devcontainer/devcontainer.env || true",
	"postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.config/opencode /home/vscode/.local/share/opencode && sudo chmod 666 /var/run/docker.sock && sudo mkdir -p /home/vscode/.local/state && sudo chown vscode:vscode /home/vscode/.local /home/vscode/.local/state && cd web && npm install && dapr init --slim",
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"a-h.templ",
				"opentofu.vscode-opentofu",
				"gitlab.gitlab-workflow",
				"sst-dev.opencode"
			]
		}
	}
}
