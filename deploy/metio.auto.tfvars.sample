# copy this file to metio.auto.tfvars and change the values as needed
project_id = "TBD"
region     = "TBD"
zone       = "TBD"
admin_users = "your-email@example.com"
# "cloudsql" (default) auto-provisions a Cloud SQL instance and writes the
# connection string to the postgres-connection-string secret;
# "byo" expects a user-filled postgres-connection-string secret (e.g. Neon, CockroachDB)
# postgres_mode = "cloudsql"
#
# When postgres_mode = "byo", set this to the Secret Manager secret ID (same
# project) that holds the connection string. The secret and its versions are
# created and rotated outside OpenTofu — create it before applying:
#   gcloud secrets create <secret-id>
#   echo -n '{"postgres-connection-string":"postgres://..."}' | \
#     gcloud secrets versions add <secret-id> --data-file=-
# postgres_connection_string_secret_id = ""
#
# How long backups are kept after a server is deleted (ADR-0004). Defaults to 30 days.
# backup_deleted_server_retention_days = 30
