#cloud-config
device_aliases: {minecraft_data: /dev/disk/by-id/google-minecraft-data}
fs_setup:
  - {device: minecraft_data, filesystem: ext4, label: fs1}
mounts:
  - [minecraft_data, /mnt/disks/minecraft/data, ext4, "defaults", "0", "2"]
users:
  - name: metio
    gecos: Metio User
    shell: /bin/bash
    primary_group: metio
    groups: docker
    system: false
write_files:
  - path: /usr/local/bin/verify-docker-image.sh
    permissions: '0755'
    owner: root
    content: |
      #!/bin/bash
      set -e
      IMAGE="${1}"
      MAX_RETRIES=3
      
      for i in $(seq 1 $MAX_RETRIES); do
        echo "[$(date)] Attempt $i/$MAX_RETRIES: Pulling $IMAGE..."
        if docker pull "$IMAGE"; then
          if echo "$IMAGE" | grep -q "minecraft-server"; then
            SIZE=$(docker run --rm --entrypoint stat "$IMAGE" -c%s /opt/java/openjdk/bin/java 2>/dev/null || echo 0)
            if [ "$SIZE" -gt 1000 ]; then
              echo "[$(date)] Java executable verified ($SIZE bytes)"
              exit 0
            fi
            echo "[$(date)] Verification failed (size: $SIZE bytes), removing corrupted image..."
            docker rmi -f "$IMAGE" 2>/dev/null || true
          else
            echo "[$(date)] Image pulled successfully"
            exit 0
          fi
        fi
        if [ $i -lt $MAX_RETRIES ]; then
          echo "[$(date)] Waiting 10 seconds before retry..."
          sleep 10
        fi
      done
      echo "[$(date)] CRITICAL: Failed to pull valid image after $MAX_RETRIES attempts"
      exit 1

  - path: /etc/systemd/system/minecraft.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Minecraft Server
      After=docker.service
      Requires=docker.service

      [Service]
      User=metio
      WorkingDirectory=/home/metio
      TimeoutStartSec=0
      Restart=always
      ExecStartPre=-/usr/bin/docker stop %n
      ExecStartPre=-/usr/bin/docker rm %n
      ExecStartPre=/usr/local/bin/verify-docker-image.sh itzg/minecraft-server:stable-java21
      ExecStart=/usr/bin/docker run --rm --name %n \
        -p 25565:25565 \
        -p 127.0.0.1:25575:25575 \
        -e EULA=TRUE \
        -e VERSION=${minecraftVersion} \
        -e MAX_MEMORY=3G \
        -e USE_MEOWICE_FLAGS=true \
        -e RCON_PASSWORD=${rconPassword} \
        -v /mnt/disks/minecraft/data:/data \
        itzg/minecraft-server:stable-java21
      ExecStop=/usr/bin/docker stop %n

      [Install]
      WantedBy=default.target

  - path: /etc/systemd/system/minecraft-backup.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Minecraft Backup Service
      After=minecraft.service
      Requires=minecraft.service

      [Service]
      User=metio
      WorkingDirectory=/home/metio
      TimeoutStartSec=0
      Restart=always
      ExecStartPre=-/usr/bin/docker stop %n
      ExecStartPre=-/usr/bin/docker rm %n
      ExecStartPre=/usr/local/bin/verify-docker-image.sh itzg/mc-backup
      ExecStart=/usr/bin/docker run --rm --name %n \
        --network host \
        -e BACKUP_METHOD=restic \
        -e BACKUP_INTERVAL=1h \
        -e PRUNE_RESTIC_RETENTION="--keep-within 3m" \
        -e RESTIC_REPOSITORY=gs:${backupBucket}:/ \
        -e RESTIC_PASSWORD=${rconPassword} \
        -e RCON_HOST=127.0.0.1 \
        -e RCON_PASSWORD=${rconPassword} \
        -v /mnt/disks/minecraft/data:/data \
        itzg/mc-backup
      ExecStop=/usr/bin/docker stop %n

      [Install]
      WantedBy=default.target

  - path: /etc/systemd/system/metio-machine-agent.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Metio Machine Agent
      After=docker.service
      Requires=docker.service

      [Service]
      User=metio
      WorkingDirectory=/home/metio
      TimeoutStartSec=0
      Restart=always
      ExecStartPre=/usr/bin/docker-credential-gcr configure-docker --registries ${region}-docker.pkg.dev
      ExecStartPre=-/usr/bin/docker stop %n
      ExecStartPre=-/usr/bin/docker rm %n
      ExecStartPre=/usr/local/bin/verify-docker-image.sh ${machineAgentImage}
      ExecStart=/usr/bin/docker run --rm --name %n \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -e ENVIRONMENT=${environment} \
        -e REGION=${region} \
        -e INSTANCE_NAME=${instanceName} \
        -e GCP_PROJECT=${gcpProject} \
        ${machineAgentImage}
      ExecStop=/usr/bin/docker stop %n

      [Install]
      WantedBy=default.target

runcmd:
  - systemctl daemon-reload
  - systemctl enable minecraft minecraft-backup metio-machine-agent
  - systemctl start minecraft minecraft-backup metio-machine-agent
