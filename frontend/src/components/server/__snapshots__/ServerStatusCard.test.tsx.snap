exports[`ServerStatusCard > Running State > matches running snapshot 1`] = `
<div
  class="card"
>
  <div
    class="card-header"
  >
    <h2
      class="card-title"
    >
      Server Status
      <span
        class="badge badge-online"
      >
        Online
      </span>
    </h2>
  </div>
  <div
    class="card-content"
  >
    <div
      class="stats-grid"
    >
      <div
