# Metio Environment Configuration
#
# Copy this file to .env and fill in your values, or use the devcontainer
# setup which loads from .devcontainer/devcontainer.env automatically.

# Required
GCP_PROJECT=TBD
REGION=us-central1
MACHINE_AGENT_IMAGE=TBD

# Server defaults
PORT=8080
ENVIRONMENT=development

# DB Backend (firestore or dapr)
# DB_BACKEND=firestore
# DAPR_STATE_STORE_NAME=statestore

# Authentication (Google OAuth)
GOOGLE_CLIENT_ID=TBD
GOOGLE_CLIENT_SECRET=TBD
SESSION_KEY=change-me
BASE_URL=http://localhost:8080
ALLOWED_USERS=TBD

# Operation mode: cloudtasks (production) or goroutine (local dev)
# OPERATION_MODE=goroutine
# CLOUD_TASKS_QUEUE=TBD
# CLOUD_TASKS_REGION=TBD
# CONTROLLER_SERVICE_ACCOUNT=TBD

# Dev mode (bypasses auth for local development)
# DEV_MODE=true
# DEV_API_KEY=my-secret
